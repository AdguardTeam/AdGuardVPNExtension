.profile {
    padding: 0 16px 16px;
}

.screenTitle {
    padding-bottom: 12px;
}

.sectionTitle {
    padding-top: 48px;
    padding-bottom: 12px;
}

.profileTitle {
    color: var(--text-main-text-main-default);
    font-size: 16px;
    line-height: 1.3;
    font-weight: 600;
}

.profileLink {
    word-break: break-all;
    padding: 0;
    border: none;
    background: none;
    color: var(--text-links-link-default);
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    font-weight: 400;
    text-decoration: underline;
    cursor: pointer;
}

.profileDescription {
    color: var(--text-description-description-default);
    font-size: 16px;
    line-height: 1.3;
    margin-top: 12px;
}
