.root {
    position: relative;
    display: flex;
    flex-direction: column;
}

.list {
    display: flex;
    flex-direction: column;
}

.item {
    display: flex;
}

.itemRadio {
    overflow-wrap: anywhere;
}

.itemChevron {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    align-self: stretch;
    width: 57px;
    border-radius: 8px;
    transition: var(--t3);

    &:hover {
        background-color: var(--fills-backgrounds-page-background-hovered);
    }

    &:active {
        background-color: var(--fills-backgrounds-page-background-pressed);
    }
}

/* Divider between the profiles list and the create button. */
.divider {
    height: 1px;
    background-color: var(--stroke-dividers-item-divider-default);
}

.actionsButton {
    color: var(--text-placeholder-placeholder-default);
}

.actionDanger {
    color: var(--text-links-error-link-default);
}
