.root {
    position: relative;
    flex-shrink: 0;
}

.menu {
    position: absolute;
    bottom: 8px;
    left: calc(100% - 24px);
    z-index: var(--sidebar-z);
    max-height: calc(100dvh - 100% - 16px);

    @media (--tablet) {
        right: auto;
        bottom: calc(100% - 8px);
        left: 8px;
    }
}

.button {
    display: flex;
    align-items: center;
    column-gap: 12px;
    width: 100%;
    padding: 24px 32px;
    border: none;
    border-top: 1px solid var(--stroke-dividers-item-divider-default);
    background: none;
    cursor: pointer;
    color: var(--text-main-text-main-default);
    font-size: 16px;
    line-height: 1.3;
    text-align: start;
    transition: var(--t3) background-color;

    @media (--hover) {
        &:hover {
            background-color: var(--fills-backgrounds-page-background-additional-hovered);
        }
    }

    &:focus-visible {
        background-color: var(--fills-backgrounds-page-background-additional-hovered);
    }

    &:active {
        background-color: var(--fills-backgrounds-page-background-additional-pressed);
    }

    &.active {
        background-color: var(--fills-backgrounds-page-background-default);
    }
}

.avatar {
    flex-shrink: 0;
    color: var(--stroke-icons-gray-icons-default);
}

.name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
