.profile-hint {
    color: var(--text-description-description-default);
    display: block;
    margin-top: 4px;
    max-width: 100%;
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 100%;

    .profile-hint__name {
        color: var(--text-links-link-default);
        font-weight: 400;
        text-decoration: underline;
    }

    /* Interactive variant (button) */
    &.profile-hint--interactive {
        cursor: pointer;
        font: inherit;

        &:focus-visible {
            outline: 2px solid var(--text-links-link-default);
            outline-offset: 2px;
            border-radius: 2px;
        }
    }
}
