.profile-hint {
    color: var(--orange-50);
    display: block;
    margin-top: 4px;
    max-width: 100%;
    overflow: hidden;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 100%;

    /* Interactive variant (button) */
    &.profile-hint--interactive {
        text-decoration: underline;
        font: inherit;

        &:focus-visible {
            outline: 2px solid var(--orange-50);
            outline-offset: 2px;
            border-radius: 2px;
        }
    }
}
