.choice-onboarding {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 16px;
    box-sizing: border-box;
}

.choice-onboarding__image-wrapper {
    display: flex;
    justify-content: center;
    margin: 0 -16px 24px;
}

.choice-onboarding__image {
    width: 100%;
    height: auto;
}

.choice-onboarding__title {
    color: var(--text-main-text-main-default);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    margin-bottom: 24px;
}

.choice-onboarding__options {
    display: flex;
    flex-direction: column;
}

.choice-onboarding__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px 0;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
}

.choice-onboarding__option-arrow {
    color: var(--text-description-description-default);
}
